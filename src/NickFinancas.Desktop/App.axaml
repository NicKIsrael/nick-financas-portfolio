<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NickFinancas.Desktop.App"
             xmlns:local="using:NickFinancas.Desktop"
             RequestedThemeVariant="Dark">

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <Color x:Key="AppBackgroundColor">#F4F7FB</Color><Color x:Key="SurfaceColor">#FFFFFF</Color>
                <Color x:Key="SurfaceAltColor">#EDF3FA</Color><Color x:Key="SidebarColor">#14243A</Color>
                <Color x:Key="TextColor">#162033</Color><Color x:Key="MutedTextColor">#627086</Color>
                <Color x:Key="BorderColor">#D7E1EE</Color><Color x:Key="AccentColor">#2563EB</Color>
                <Color x:Key="PositiveColor">#15803D</Color><Color x:Key="NegativeColor">#B64B4B</Color>
                <Color x:Key="ChartExpenseColor">#DD9F3D</Color>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <Color x:Key="AppBackgroundColor">#0B1220</Color><Color x:Key="SurfaceColor">#111C2E</Color>
                <Color x:Key="SurfaceAltColor">#1A2940</Color><Color x:Key="SidebarColor">#07101F</Color>
                <Color x:Key="TextColor">#EFF6FF</Color><Color x:Key="MutedTextColor">#94A3B8</Color>
                <Color x:Key="BorderColor">#293B55</Color><Color x:Key="AccentColor">#60A5FA</Color>
                <Color x:Key="PositiveColor">#4ADE80</Color><Color x:Key="NegativeColor">#F08080</Color>
                <Color x:Key="ChartExpenseColor">#E4AD55</Color>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PositiveBrush" Color="{DynamicResource PositiveColor}" />
        <SolidColorBrush x:Key="NegativeBrush" Color="{DynamicResource NegativeColor}" />
        <SolidColorBrush x:Key="ChartExpenseBrush" Color="{DynamicResource ChartExpenseColor}" />
      </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Application.Styles>
</Application>
